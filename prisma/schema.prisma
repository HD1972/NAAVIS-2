

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model user{
  id String @id @default(cuid()) @map("_id")
  name String
  email String 
  image String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}